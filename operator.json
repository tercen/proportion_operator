{
  "name": "Count and Proportion",
  "description": "Calculates counts and relative proportions per row, column, and overall.",
  "tags": [
    "preprocessing",
    "descriptive statistics"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/proportion_operator"
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Row Factor",
            "type": "",
            "description": "(Optional) Variable factor such as sample or group of interest.",
            "ontologyMapping": "variable",
            "crosstabMapping": "row",
            "cardinality": "0..n",
            "factors": []
          },
          {
            "kind": "MetaFactor",
            "name": "Column Factor",
            "type": "",
            "description": "(Optional) Variable factor such as cluster.",
            "ontologyMapping": "variable",
            "crosstabMapping": "column",
            "cardinality": "0..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "Input Values",
                "type": "double",
                "description": "Numeric input values for proportion calculation.",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "Row Factor",
                "Column Factor"
              ],
              "rColumns": [
                "Row Factor",
                "Column Factor"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "n",
                  "type": "double"
                },
                {
                  "kind": "Attribute",
                  "name": "prop_per_row",
                  "type": "double"
                },
                {
                  "kind": "Attribute",
                  "name": "prop_per_col",
                  "type": "double"
                },
                {
                  "kind": "Attribute",
                  "name": "prop_overall",
                  "type": "double"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}